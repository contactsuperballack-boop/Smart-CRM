# --- Core ---
NODE_ENV=production
DATABASE_URL=postgres://crm_app:***@host:5432/crm      # the restricted app role, not the owner
REDIS_URL=redis://host:6379
PORT=3000                                              # API
INBOUND_PORT=3001                                      # inbound-email webhook
APP_URL=https://app.yourdomain.com                     # where the UI is served
APP_ORIGIN=                                            # leave empty: the browser calls /api on the same origin

# --- AI ---
ANTHROPIC_API_KEY=
DRAFT_MODEL=claude-sonnet-5-5
CLASSIFY_MODEL=claude-sonnet-5-5
FOLLOWUP_MODEL=claude-sonnet-5-5

# --- Gmail OAuth (send-only) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.yourdomain.com/api/oauth/google/callback   # via the Vercel /api rewrite
STATE_SECRET=                                          # openssl rand -hex 32
TOKEN_KEY=                                             # openssl rand -base64 32  (exactly 32 bytes once decoded)

# --- Inbound replies (Postmark) ---
REPLY_DOMAIN=reply.yourdomain.com
INBOUND_USER=postmark
INBOUND_PASS=                                          # openssl rand -hex 24; same pair goes in the Postmark webhook URL

# --- Auth provider (Clerk/Auth0/Supabase): add whatever verifyToken() needs ---
